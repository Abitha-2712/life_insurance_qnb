# Mirrors Flutter active base_url.dart â€” ask before changing production hosts.
# Browser uses Vite proxy paths; upstreams are configured in vite.config.js.

VITE_DATA_API=/data-api
VITE_BO_API=/bo-api
VITE_WFC_API=/wfc-api
VITE_GRAPHQL_API=/graphql-api

# Upstream (Vite proxy):
# baseUrl + data-api (session parity) = https://34.18.92.50:8444/backoffice-insurance/
# baseUrlWFC = https://34.18.92.50:8444/workflow-insurance/
# Flutter graphql = https://34.18.92.50:8444/graphql → /graphql-api
# Flutter dataurl is 8443; React /data-api proxies to Flutter dataurl :8443; session bridged via cookie rewrite + X-Managed-Cookie.
