# Example env — mirrors Flutter qnb-insurance-ui/lib/network/url/base_url.dart active block.
# Do not commit secrets. Ask before changing production hosts.

VITE_DATA_API=/data-api
VITE_BO_API=/bo-api
VITE_WFC_API=/wfc-api
VITE_GRAPHQL_API=/graphql-api
VITE_SERVICE_API=/service-api

# Upstream (Vite proxy):
# baseUrl + data-api (session parity) = https://34.18.92.50:8444/backoffice-insurance/
# baseUrlWFC = https://34.18.92.50:8444/workflow-insurance/
# Flutter graphql = https://34.18.92.50:8444/graphql → /graphql-api
# Flutter dataurl is 8443; React /data-api uses 8444 so login cookies apply.
# Login audit graph = http://34.18.92.50:8443/backoffice-service → /service-api
